+
+	/* Registrar-observed rport Contact is an explicit SIP-NAT mode. */
+	err = account_set_sipnat(acc, "received");
+	TEST_ERR(err);
+	ASSERT_STREQ("received", account_sipnat(acc));
+
+ out:
+	mem_deref(acc);
+	return err;
+}
