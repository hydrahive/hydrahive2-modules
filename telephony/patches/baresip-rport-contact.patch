+/**
+ * Set the registrar-observed UDP Contact URI for dialog responses.
+ *
+ * @param ua    User-Agent
+ * @param addr  Registrar-observed address and port
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int ua_nat_contact_set(struct ua *ua, const struct sa *addr)
+{
+	char *contact = NULL;
+	int err;
+
+	if (!ua || !addr || !sa_isset(addr, SA_ALL))
+		return EINVAL;
+
+	err = re_sdprintf(&contact, "sip:%s@%J", ua->cuser, addr);
+	if (err)
+		return err;
+
+	ua->nat_contact = mem_deref(ua->nat_contact);
+	ua->nat_contact = contact;
+	return 0;
+}
+
