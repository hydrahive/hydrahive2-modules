+int test_sipreg_rport_contact(void)
+{
+	struct test test;
+	struct sip_server *srv = NULL;
+	struct sipreg *reg = NULL;
+	struct sip *sip = NULL;
+	const struct sip_hdr *contact_hdr;
+	const struct sa *learned;
+	struct sip_addr contact;
+	struct sa advertised;
+	char reg_uri[256];
+	int err;
+
+	memset(&test, 0, sizeof(test));
+	test.tp = SIP_TRANSP_UDP;
+
+	err = sip_server_alloc(&srv);
+	TEST_ERR(err);
+	err = sipstack_fixture(&sip);
+	TEST_ERR(err);
+	err = sip_server_uri(srv, reg_uri, sizeof(reg_uri), SIP_TRANSP_UDP);
+	TEST_ERR(err);
+	err = sipreg_alloc(&reg, sip, reg_uri, "sip:x@test", NULL,
+			   "sip:x@test", 3600, "x", NULL, 0, 0, NULL, NULL,
+			   false, sip_resp_handler, &test, NULL, NULL);
+	TEST_ERR(err);
+
+	/* The behavior is strictly opt-in. */
+	err = sipreg_send(reg);
+	TEST_ERR(err);
+	err = re_main_timeout(1000);
+	TEST_ERR(err);
+	ASSERT_TRUE(sipreg_contact_addr(reg) == NULL);
+
+	sipreg_enable_rport_contact(reg, true);
+	err = sipreg_send(reg);
+	TEST_ERR(err);
+	err = re_main_timeout(1000);
+	TEST_ERR(err);
+
+	learned = sipreg_contact_addr(reg);
+	ASSERT_TRUE(learned != NULL);
+	ASSERT_TRUE(sa_isset(learned, SA_ALL));
+
+	/* A later REGISTER advertises the tuple learned from Via received/rport. */
+	err = sipreg_send(reg);
+	TEST_ERR(err);
+	err = re_main_timeout(1000);
+	TEST_ERR(err);
+
+	contact_hdr = sip_msg_hdr(srv->sip_msgs[srv->n_register_req - 1],
+				  SIP_HDR_CONTACT);
+	ASSERT_TRUE(contact_hdr != NULL);
+	err = sip_addr_decode(&contact, &contact_hdr->val);
+	TEST_ERR(err);
+	err = sa_set(&advertised, &contact.uri.host, contact.uri.port);
+	TEST_ERR(err);
+	TEST_SACMP(learned, &advertised, SA_ALL);
+
+ out:
+	tmr_cancel(&test.tmr);
+	sipreg_unregister(reg);
+	mem_deref(reg);
+	sip_close(sip, true);
+	mem_deref(sip);
+	mem_deref(srv);
+	return err;
+}
