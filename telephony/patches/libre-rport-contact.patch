+/**
+ * Enable use of the tuple returned in Via received/rport as UDP Contact.
+ *
+ * The tuple is learned only from a response matched to this registration.
+ * It is advertised as Contact and is never used as a request destination.
+ *
+ * @param reg     SIP registration client
+ * @param enable  True to enable the opt-in behavior
+ */
+void sipreg_enable_rport_contact(struct sipreg *reg, bool enable)
+{
+	if (!reg)
+		return;
+
+	reg->use_rport_contact = enable;
+	if (!enable)
+		sa_init(&reg->contact_addr, AF_UNSPEC);
+}
+
+
+/**
+ * Get the registrar-observed UDP Contact tuple, if one has been learned.
+ *
+ * @param reg SIP registration client
+ *
+ * @return Learned Contact address, or NULL
+ */
+const struct sa *sipreg_contact_addr(const struct sipreg *reg)
+{
+	if (!reg || !reg->use_rport_contact ||
+	    !sa_isset(&reg->contact_addr, SA_ALL))
+		return NULL;
+
+	return &reg->contact_addr;
+}
