+static void update_rport_contact(struct sipreg *reg,
+				 const struct sip_msg *msg)
+{
+	struct pl received;
+	struct pl rport;
+	struct sa addr;
+	uint32_t port;
+
+	if (!reg->use_rport_contact || msg->tp != SIP_TRANSP_UDP)
+		return;
+
+	if (msg_param_decode(&msg->via.params, "received", &received) ||
+	    msg_param_decode(&msg->via.params, "rport", &rport))
+		return;
+
+	if (!pl_isset(&rport) || rport.l > 5)
+		return;
+
+	port = pl_u32(&rport);
+	if (!port || port > UINT16_MAX)
+		return;
+
+	if (sa_set(&addr, &received, port) || !sa_isset(&addr, SA_ALL))
+		return;
+
+	reg->contact_addr = addr;
+}
