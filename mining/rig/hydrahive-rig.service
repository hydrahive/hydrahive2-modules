[Unit]
Description=HydraHive Rig-Client (Mining)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hh-rig
Group=hh-rig
SupplementaryGroups=video render
Environment=PYTHONPATH=/opt/hydrahive-rig
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m hydrahive_rig --config /etc/hydrahive-rig/config.json run
Restart=always
RestartSec=10

# Härtung: der Client braucht nur Netz, GPU-Geräte und seine Konfiguration.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/hydrahive-rig
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
